FROM docker.io/library/python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
COPY --from=ghcr.io/astral-sh/uv:0.11.24@sha256:47baf5ae03cf5c4418c0e76a54a78a95ef079d31e7315d2c450e4383c9f184bc /uv /usr/local/bin/uv
WORKDIR /app

FROM base AS deps
COPY services/api/pyproject.toml services/api/uv.lock services/api/.python-version ./
RUN uv sync --locked --no-dev --no-install-project

# api: no ffmpeg, no torch (SEC-027). 0.0.0.0 is correct inside the container; the HOST
# binding is the loopback one (compose, SEC-165).
FROM deps AS api
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    PATH="/app/.venv/bin:${PATH}"
COPY services/api/src ./src
COPY services/api/alembic.ini ./
COPY services/api/migrations ./migrations
# /data/blobs is created and owned by 10001 BEFORE the volume is declared, so a new named
# volume inherits that ownership on first use.
RUN uv sync --locked --no-dev \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin saveclock \
    && mkdir -p /data/blobs \
    && chown 10001:10001 /data/blobs
VOLUME ["/data/blobs"]
USER 10001
EXPOSE 8000
CMD ["uvicorn", "saveclock.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS ffmpeg-fetch
COPY infra/docker/ffmpeg.pin infra/docker/fetch_ffmpeg.py /fetch/
COPY infra/docker/cache/ /cache/
RUN python /fetch/fetch_ffmpeg.py /fetch/ffmpeg.pin /cache /out

# worker: the api image plus the sha256-verified FFmpeg (SEC-170). No torch in Phase 1.
FROM api AS worker
COPY --from=ffmpeg-fetch --chmod=0755 /out/ffmpeg /out/ffprobe /usr/local/bin/
CMD ["dramatiq", "saveclock.workers.main", "--processes", "1", "--threads", "4", "--queues", "analysis", "fetch", "render"]
