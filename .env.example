# GENERATED by scripts/gen_env_docs.py from saveclock.config. Do not edit by hand.
# `make env` copies this to .env and fills every placeholder secret with a random value.
# Lines starting with # show the default; Settings owns every name (infra/ENV.md).

# compose-only secrets (C10)
# superuser password for the postgres container
POSTGRES_PASSWORD=CHANGE_ME
# password of role app_rw
POSTGRES_APP_PASSWORD=CHANGE_ME
# password of role migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME
# requirepass for redis
REDIS_PASSWORD=CHANGE_ME
# host port of the api (default 8000; the restore scratch stack uses 18000)
# API_PORT=8000
# host port of the web shell (default 3000; the scratch stack uses 13000)
# WEB_PORT=3000
# tag of the saveclock-* images compose runs (default local; rollback: sha-<commit>)
# IMAGE_TAG=local

